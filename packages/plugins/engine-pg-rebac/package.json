{
  "name": "@louvain/engine-pg-rebac",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../../scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "test": "node ../../../scripts/run-tests.mjs -- test/*.test.ts",
    "test:db": "node ../../../scripts/run-tests.mjs -- test/db/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@louvain/engine-core": "workspace:*"
  },
  "peerDependencies": {
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@louvain/engine": "workspace:*",
    "postgres": "^3.4.9"
  }
}
