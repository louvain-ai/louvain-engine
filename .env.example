# The engine's settings. `./engine up` copies this to .env on its first run; nothing here is a secret.
# .env may set only the names listed in this file (set or commented out): `./engine` refuses any other, because a
# variable such as NODE_OPTIONS changes what code a program loads. A value is taken as written: one pair of outer
# quotes is removed, and nothing inside it ($, backticks, $(...)) is expanded.

# THE PORTS on this machine, one setting each. Docker Compose publishes the services on them (loopback only), and
# `./engine` builds the engine's URLs from them, so a busy port is moved by changing its one line here.
# LOUVAIN_PG_HOST_PORT=5434
# LOUVAIN_EMBEDDINGS_HOST_PORT=8091
# LOUVAIN_BM25_HOST_PORT=8095
# LOUVAIN_ENGINE_PORT=8080
# The local reranker's sidecar, which `./engine up` starts when engine.config.ts runs it.
# LOUVAIN_RERANK_HOST_PORT=8096
# The bulk embedding lane is a compose profile (`--profile bulk`); set its URL once it runs.
# LOUVAIN_EMBEDDINGS_BULK_HOST_PORT=8092
# LOUVAIN_EMBEDDINGS_BULK_URL=http://localhost:8092

# The engine's URLs, when they are not the ones built from the ports above (a database or a sidecar elsewhere).
# A DATABASE_URL set here is yours: `./engine` never changes a password it relies on.
# DATABASE_URL=postgres://engine:<password>@localhost:5434/engine
# LOUVAIN_EMBEDDINGS_URL=http://localhost:8091
# LOUVAIN_BM25_URL=http://localhost:8095
# LOUVAIN_RERANK_URL=http://localhost:8096

# The sidecars' token, which every request but the health check must carry. Unset, `./engine up` makes a random one
# in .engine/sidecar-token (as it makes the database's password in .engine/db-password); neither is ever printed.
LOUVAIN_SIDECAR_TOKEN=
# The embedding sidecar's work at once and its queue (1 and 64).
# LOUVAIN_EMBEDDINGS_CONCURRENCY=1
# LOUVAIN_EMBEDDINGS_MAX_QUEUE=64

# The tool server's token, at least 32 characters. Unset, the server writes a random one to .engine/token at first
# start.
LOUVAIN_ENGINE_TOKEN=

# The HTTP door's token, at least 32 characters and not the token above, which agents are given and which never
# writes. POST /ingest is off until engine.config.ts names http() with it; set here alone, it opens nothing.
# LOUVAIN_ENGINE_INGEST_TOKEN=

# File readers: which run is said in engine.config.ts, never here. The bounds the engine holds every reader to: bytes
# read (32 MB), characters kept (1,000,000), time (60000 ms).
# LOUVAIN_FILE_MAX_BYTES=
# LOUVAIN_FILE_MAX_CHARS=
# LOUVAIN_FILE_READ_DEADLINE_MS=

# How a search ranks a document: by its best passage (0), or by the sum of all of them (1). The search's other settings
# are `settings` in engine.config.ts, never here.
# LOUVAIN_AGENT_SEARCH_CHUNK_BONUS=1
# Whether a ranked page tells the documents that match from those only loosely related (on, the default here, or off:
# one ranked list).
# LOUVAIN_SEARCH_RELEVANCE=on

# The reranker: which one runs is said in engine.config.ts, never here. How long a search waits for it (milliseconds;
# 4000 when unset), and the key Cohere's reranker reads when engine.config.ts names it.
# LOUVAIN_RERANK_TIMEOUT_MS=
COHERE_API_KEY=

# Behind a TLS proxy: the address people reach the app at. Unset, it answers loopback on its own port only.
# LOUVAIN_ENGINE_PUBLIC_ORIGIN=
# Ask answers with your own model key; Search needs none. Which answerer and which model are engine.config.ts's
# (`answerer`), never a setting here.
ANTHROPIC_API_KEY=
# What one answer may spend: model turns (6, at most 10) and tokens across them (100000, from 20000 to 400000).
# LOUVAIN_APP_ASK_ROUNDS=
# LOUVAIN_APP_ASK_TOKENS=
